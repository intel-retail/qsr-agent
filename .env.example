# `make up` copies this file to .env on every run; edit settings here, not in .env.
MODEL_ROOT=./models
MODEL_ID=OpenVINO/Qwen3-8B-int4-ov
OVMS_PORT=4444
QSR_UI_PORT=8600
QSR_UI_HOST=0.0.0.0

# Optional: pin the Hermes installer revision for reproducible image builds.
HERMES_INSTALL_COMMIT=

# Weather MCP service (services/weather) loopback debug port.
WEATHER_PORT=8090

# EdgeMart sim services (qsr-store-pos-agent repo's sim-service-mcp/
# table-sim-service-mcp/footfall-sim-service-mcp compose services,
# streamable-http). Defaults assume that repo's Docker stack runs on this same
# host; override if it runs elsewhere. Empty removes the registration (Hermes
# treats an empty url the same way it does for QSR_WEATHER_MCP_URL).
EDGEMART_SIM_MCP_URL=http://host.docker.internal:3101/mcp
EDGEMART_TABLE_SIM_MCP_URL=http://host.docker.internal:3201/mcp
EDGEMART_FOOTFALL_SIM_MCP_URL=http://host.docker.internal:3301/mcp

# Corporate proxy: export http_proxy/https_proxy/no_proxy in the shell before
# `make up`; they are passed to builds and containers. List LAN hosts the agent
# calls directly (e.g. a remote SAD host IP) here, comma-separated.
QSR_EXTRA_NO_PROXY=