# `make up` copies this file to .env on every run; edit settings here, not in .env.
MODEL_ROOT=./models
MODEL_ID=OpenVINO/Qwen3-30B-A3B-Instruct-2507-int4-ov
OVMS_PORT=4444
QSR_UI_PORT=8600
QSR_UI_HOST=0.0.0.0

# Optional: override the Hermes installer revision for image builds; set both, or leave
# empty to use the commit and SHA-256 pinned in scripts/hermes-pin.sh.
HERMES_INSTALL_COMMIT=
HERMES_INSTALL_SHA256=

# Weather MCP service (services/weather) loopback debug port.
WEATHER_PORT=8090

# Remote MCP services, format http://<host>:<port>/mcp (port before /mcp).
# All optional; set only the services you want to connect.
# No default: left empty, the service is not registered.
QSR_SAD_MCP_URL=
QSR_LP_MCP_URL=
# Kiosk (smart-kiosk-assistant) and Order Accuracy (take-away, dine-in) run on
# their own hosts. Without these URLs the agent has no kiosk or order-accuracy data,
# e.g. http://<kiosk-host>:8014/mcp, http://<take-away-host>:8010/mcp,
# http://<dine-in-host>:8011/mcp. See docs/user-guide/get-started/configuration.md.
QSR_ORDER_ACCURACY_TAKE_AWAY_MCP_URL=
QSR_ORDER_ACCURACY_DINE_IN_MCP_URL=
QSR_KIOSK_MCP_URL=

# Defaults shown; left empty, docker-compose.yaml uses the same default.
# host.docker.internal is this host; use the real IP for another machine.
QSR_WEATHER_MCP_URL=http://weather:8090/mcp
QSR_DIGITAL_SIGNAGE_MCP_URL=https://host.docker.internal:5000/mcp
# EdgeMart sims (qsr-store-pos-agent repo's store-activity-service-mcp,
# table-occupancy-service-mcp, footfall-service-mcp compose services).
EDGEMART_SIM_MCP_URL=http://host.docker.internal:3101/mcp
EDGEMART_TABLE_SIM_MCP_URL=http://host.docker.internal:3201/mcp
EDGEMART_FOOTFALL_SIM_MCP_URL=http://host.docker.internal:3301/mcp

# Corporate proxy: export http_proxy/https_proxy/no_proxy in the shell before
# `make up`; they are passed to builds and containers. List LAN hosts the agent
# calls directly (e.g. a remote SAD host IP) here, comma-separated.
QSR_EXTRA_NO_PROXY=